# Built for EvalHub's k8s Job runtime (config/evalhub.yaml's
# provider.runtime.k8s.image) -- unlike the other services here, eval-suite
# has no HTTP server; EvalHub drops a job spec into the container and runs
# src.evalhub_entrypoint once.
#
# UNLIKE every sibling service's Containerfile, this one must be built with
# the *repo root* as build context (not eval-suite/), because seed_data.py
# and prompts.py deliberately read ground-truth files that live outside
# eval-suite/ (the shared products.csv, local-wms-api's and
# local-inventory-robot-api's own seed CSVs, prompt-registry/prompts.json --
# see CLAUDE.md's "Shared demo data" section). Build with:
#   podman build -f eval-suite/Containerfile -t dc-eval-suite .
FROM registry.redhat.io/rhai/base-image-cpu-rhel9:3.4.0-1777399554
WORKDIR /app
COPY eval-suite/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt eval-hub-sdk
COPY eval-suite/src ./src
COPY eval-suite/config ./config
COPY products.csv ./products.csv
COPY local-wms-api/data/inventory.csv ./local-wms-api/data/inventory.csv
COPY local-inventory-robot-api/data/shelves.csv ./local-inventory-robot-api/data/shelves.csv
COPY prompt-registry/prompts.json ./prompt-registry/prompts.json
ENV REPO_ROOT_OVERRIDE=/app
ENTRYPOINT ["python", "-m", "src.evalhub_entrypoint"]
