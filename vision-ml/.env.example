# Base URL of the label-api service the notebooks pull training/eval images from.
LABEL_API_URL=http://localhost:8005

# Where generated datasets and trained checkpoints are written.
DATA_DIR=data

# MLflow experiment tracking (optional - training notebooks no-op into local-only mode if
# MLFLOW_TRACKING_URI is unset). Same server/auth pattern as the rest of the repo: get
# MLFLOW_TRACKING_TOKEN via `oc whoami --show-token` (it expires - refresh it each session).
MLFLOW_TRACKING_URI=https://rh-ai.apps.ocp.home.glroland.com/mlflow
MLFLOW_WORKSPACE=distribution-center
MLFLOW_TRACKING_TOKEN=
