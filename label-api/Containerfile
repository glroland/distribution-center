FROM registry.redhat.io/rhai/base-image-cpu-rhel9:3.4.0-1777399554

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src ./src
COPY prompts.json ./
# The 3 vision-ml-trained SKU inference checkpoints (localizer.pt,
# orientation.pt, ocr.pt) - baked into the image so POST /infer never
# depends on a volume mount or a separate model-serving step.
COPY models ./models

# Runs under OpenShift's restricted-v2 SCC (arbitrary non-root UID at
# deploy time, see deploy/helm's adc.containerSecurityContext), so the
# bulk-zip output dir must be pre-created and opened up at build time
# or POST /generate-bulk fails with PermissionError -- same reasoning as
# po-ingest-api's /.cache.
RUN mkdir -p /app/output && chmod -R 777 /app/output

ENV HOST=0.0.0.0
ENV PORT=8005
ENV BULK_OUTPUT_DIR=/app/output
ENV INFERENCE_MODELS_DIR=/app/models
EXPOSE 8005

CMD ["python", "-m", "src"]
