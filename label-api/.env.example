HOST=0.0.0.0
PORT=8005
LOG_LEVEL=INFO

# Every generated image picks a random size in these ranges - no output is a fixed size.
MIN_IMAGE_WIDTH=480
MAX_IMAGE_WIDTH=900
MIN_IMAGE_HEIGHT=360
MAX_IMAGE_HEIGHT=700

# Local folder bulk-generated images are staged in (as batch-<uuid>/ subfolders) before zipping.
BULK_OUTPUT_DIR=output
# If true, delete each batch's image folder after zipping, leaving only the zip on disk.
BULK_CLEANUP_AFTER_ZIP=false

# SKU inference (POST /infer, see src/inference.py). Folder must contain
# localizer.pt, orientation.pt, and ocr.pt - the checkpoints vision-ml trains.
INFERENCE_MODELS_DIR=models
INFERENCE_DEVICE=cpu
INFERENCE_PAD_FRAC=0.2

# Optional: set to an MLflow tracking server URL to trace every MCP tool call.
# Left unset, tracing is disabled outright (no local ./mlruns writes).
MLFLOW_TRACKING_URI=

# mlflow | local. mlflow loads this server's MCP `instructions` string from
# the MLflow Prompt Registry (requires MLFLOW_TRACKING_URI above); local
# reads the same content from this service's own prompts.json instead (also
# baked into its container image, so local mode works standalone in a
# deployed pod too).
PROMPT_SOURCE=local
# Override path to the local prompt catalog; defaults to prompts.json in
# this service's own directory.
PROMPT_CATALOG_PATH=
