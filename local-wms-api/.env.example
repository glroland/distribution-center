HOST=0.0.0.0
PORT=8001
LOCATION_NAME=DC-VIRTUAL-01
INVENTORY_CSV_PATH=data/inventory.csv
LOG_LEVEL=INFO

# Optional: set to an MLflow tracking server URL to trace every MCP tool call.
# Left unset, tracing is disabled outright (no local ./mlruns writes).
MLFLOW_TRACKING_URI=

# mlflow | local. mlflow loads this server's MCP `instructions` string from
# the MLflow Prompt Registry (requires MLFLOW_TRACKING_URI above); local
# reads the same content from prompt-registry/prompts.json instead.
PROMPT_SOURCE=local
# Override path to the local prompt catalog; defaults to
# ../prompt-registry/prompts.json relative to this service's repo checkout.
PROMPT_CATALOG_PATH=
