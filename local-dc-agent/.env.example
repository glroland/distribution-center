PO_INGEST_API_URL=http://localhost:8000
WMS_API_URL=http://localhost:8001
ROBOT_API_URL=http://localhost:8002
SUPERVISOR_API_URL=http://localhost:8003
SHIPPING_API_URL=http://localhost:8004
LABEL_API_URL=http://localhost:8005
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=
MAX_FULFILLMENT_TURNS=20
HOST=0.0.0.0
PORT=9100
AGENT_URL=
LOG_LEVEL=INFO

# Optional: set to an MLflow tracking server URL to trace every LLM call
# (extraction, fulfillment) and outbound MCP tool call. Left unset, tracing
# is disabled outright (no local ./mlruns writes).
MLFLOW_TRACKING_URI=

# mlflow | local. mlflow loads prompts from the MLflow Prompt Registry
# (requires MLFLOW_TRACKING_URI above); local reads the same content from
# prompt-registry/prompts.json instead.
PROMPT_SOURCE=local
# Override path to the local prompt catalog; defaults to
# ../prompt-registry/prompts.json relative to this service's repo checkout.
PROMPT_CATALOG_PATH=
