FROM registry.redhat.io/rhai/base-image-cuda-rhel9:3.0.2-1782929069

WORKDIR /app

# System deps for Docling (PDF/image handling via OpenCV etc.)
RUN dnf install -y mesa-libGL glib2 \
    && dnf clean all

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src ./src

ENV HOST=0.0.0.0
ENV PORT=8000
EXPOSE 8000

CMD ["python", "-m", "src"]
