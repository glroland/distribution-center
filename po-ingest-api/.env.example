HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Optional: set to an MLflow tracking server URL to trace the convert_pdf_to_markdown
# MCP tool call. Left unset, tracing is disabled outright (no local ./mlruns writes).
MLFLOW_TRACKING_URI=

# Docling tries to torch.compile() its layout/VLM/classification models on
# first use, which requires a C++ compiler (g++) at runtime. The container
# image doesn't ship one, so this is set false there; locally it's safe to
# drop/set true if you have a compiler installed.
DOCLING_INFERENCE_COMPILE_TORCH_MODELS=false
