pipeline
{
   agent any

   options
   {
      disableConcurrentBuilds()
      buildDiscarder(logRotator(numToKeepStr: '1'))
   }

   stages
   {
      stage('Prepare')
      {
         steps
         {
            sh '''
                    echo "PATH = ${PATH}"
                '''

            git branch: 'main',
                url: 'https://github.com/glroland/dc-agent.git'
         }
      }

      stage('Create Docker Image for supervisor-api')
      {
         steps
         {
            sh 'cd supervisor-api ; docker build --no-cache -f Containerfile . --tag supervisor-api:$BUILD_NUMBER'
            sh 'cd supervisor-api ; docker save supervisor-api:$BUILD_NUMBER > supervisor-api-dockerimage.tar'
            step(followSymlinks: false, artifacts: 'supervisor-api/supervisor-api-dockerimage.tar', $class: 'ArtifactArchiver')
            sh 'cd supervisor-api ; docker rmi supervisor-api:$BUILD_NUMBER'
         }
      }

      stage('Create Docker Image for dashboard-ui')
      {
         steps
         {
            sh 'cd dashboard-ui ; docker build --no-cache -f Containerfile . --tag dashboard-ui:$BUILD_NUMBER'
            sh 'cd dashboard-ui ; docker save dashboard-ui:$BUILD_NUMBER > dashboard-ui-dockerimage.tar'
            step(followSymlinks: false, artifacts: 'dashboard-ui/dashboard-ui-dockerimage.tar', $class: 'ArtifactArchiver')
            sh 'cd dashboard-ui ; docker rmi dashboard-ui:$BUILD_NUMBER'
         }
      }

      stage('Create Docker Image for local-dc-agent')
      {
         steps
         {
            sh 'cd local-dc-agent ; docker build --no-cache -f Containerfile . --tag local-dc-agent:$BUILD_NUMBER'
            sh 'cd local-dc-agent ; docker save local-dc-agent:$BUILD_NUMBER > local-dc-agent-dockerimage.tar'
            step(followSymlinks: false, artifacts: 'local-dc-agent/local-dc-agent-dockerimage.tar', $class: 'ArtifactArchiver')
            sh 'cd local-dc-agent ; docker rmi local-dc-agent:$BUILD_NUMBER'
         }
      }

      stage('Create Docker Image for local-wms-api')
      {
         steps
         {
            sh 'cd local-wms-api ; docker build --no-cache -f Containerfile . --tag local-wms-api:$BUILD_NUMBER'
            sh 'cd local-wms-api ; docker save local-wms-api:$BUILD_NUMBER > local-wms-api-dockerimage.tar'
            step(followSymlinks: false, artifacts: 'local-wms-api/local-wms-api-dockerimage.tar', $class: 'ArtifactArchiver')
            sh 'cd local-wms-api ; docker rmi local-wms-api:$BUILD_NUMBER'
         }
      }

      stage('Create Docker Image for local-inventory-robot-api')
      {
         steps
         {
            sh 'cd local-inventory-robot-api ; docker build --no-cache -f Containerfile . --tag local-inventory-robot-api:$BUILD_NUMBER'
            sh 'cd local-inventory-robot-api ; docker save local-inventory-robot-api:$BUILD_NUMBER > local-inventory-robot-api-dockerimage.tar'
            step(followSymlinks: false, artifacts: 'local-inventory-robot-api/local-inventory-robot-api-dockerimage.tar', $class: 'ArtifactArchiver')
            sh 'cd local-inventory-robot-api ; docker rmi local-inventory-robot-api:$BUILD_NUMBER'
         }
      }

      stage('Create Docker Image for local-shipping-api')
      {
         steps
         {
            sh 'cd local-shipping-api ; docker build --no-cache -f Containerfile . --tag local-shipping-api:$BUILD_NUMBER'
            sh 'cd local-shipping-api ; docker save local-shipping-api:$BUILD_NUMBER > local-shipping-api-dockerimage.tar'
            step(followSymlinks: false, artifacts: 'local-shipping-api/local-shipping-api-dockerimage.tar', $class: 'ArtifactArchiver')
            sh 'cd local-shipping-api ; docker rmi local-shipping-api:$BUILD_NUMBER'
         }
      }

      stage('Create Docker Image for po-ingest-api')
      {
         steps
         {
            sh 'cd po-ingest-api ; docker build --no-cache -f Containerfile . --tag po-ingest-api:$BUILD_NUMBER'
            sh 'cd po-ingest-api ; docker save po-ingest-api:$BUILD_NUMBER > po-ingest-api-dockerimage.tar'
            step(followSymlinks: false, artifacts: 'po-ingest-api/po-ingest-api-dockerimage.tar', $class: 'ArtifactArchiver')
            sh 'cd po-ingest-api ; docker rmi po-ingest-api:$BUILD_NUMBER'
         }
      }

      stage('Create Docker Image for label-api')
      {
         steps
         {
            sh 'cd label-api ; docker build --no-cache -f Containerfile . --tag label-api:$BUILD_NUMBER'
            sh 'cd label-api ; docker save label-api:$BUILD_NUMBER > label-api-dockerimage.tar'
            step(followSymlinks: false, artifacts: 'label-api/label-api-dockerimage.tar', $class: 'ArtifactArchiver')
            sh 'cd label-api ; docker rmi label-api:$BUILD_NUMBER'
         }
      }

      stage('Create Docker Image for vision-ml-trainer')
      {
         steps
         {
            sh 'cd vision-ml ; docker build --no-cache -f Containerfile . --tag vision-ml-trainer:$BUILD_NUMBER'
            sh 'cd vision-ml ; docker save vision-ml-trainer:$BUILD_NUMBER > vision-ml-trainer-dockerimage.tar'
            step(followSymlinks: false, artifacts: 'vision-ml/vision-ml-trainer-dockerimage.tar', $class: 'ArtifactArchiver')
            sh 'cd vision-ml ; docker rmi vision-ml-trainer:$BUILD_NUMBER'
         }
      }

      stage('Create Docker Image for eval-suite')
      {
         steps
         {
            // Unlike every other stage above, eval-suite/Containerfile must be
            // built with the repo root as context (no `cd eval-suite` first),
            // because it copies ground-truth seed files that live outside
            // eval-suite/ (products.csv, local-wms-api/data/inventory.csv,
            // etc.) -- see the Containerfile's own comment.
            sh 'docker build --no-cache -f eval-suite/Containerfile . --tag eval-suite:$BUILD_NUMBER'
            sh 'docker save eval-suite:$BUILD_NUMBER > eval-suite/eval-suite-dockerimage.tar'
            step(followSymlinks: false, artifacts: 'eval-suite/eval-suite-dockerimage.tar', $class: 'ArtifactArchiver')
            sh 'docker rmi eval-suite:$BUILD_NUMBER'
         }
      }

      stage('Reload then push images to quay')
      {
         steps
         {
            script
            {
               docker.withRegistry('https://registry.home.glroland.com/', 'quay')
               {
                  sh 'docker load -i po-ingest-api/po-ingest-api-dockerimage.tar'
                  sh 'docker tag po-ingest-api:$BUILD_NUMBER registry.home.glroland.com/distribution-center/po-ingest-api:$BUILD_NUMBER'
                  sh 'docker rmi po-ingest-api:$BUILD_NUMBER'
                  sh 'docker push registry.home.glroland.com/distribution-center/po-ingest-api:$BUILD_NUMBER'
                  sh 'docker rmi registry.home.glroland.com/distribution-center/po-ingest-api:$BUILD_NUMBER'

                  sh 'docker load -i supervisor-api/supervisor-api-dockerimage.tar'
                  sh 'docker tag supervisor-api:$BUILD_NUMBER registry.home.glroland.com/distribution-center/supervisor-api:$BUILD_NUMBER'
                  sh 'docker rmi supervisor-api:$BUILD_NUMBER'
                  sh 'docker push registry.home.glroland.com/distribution-center/supervisor-api:$BUILD_NUMBER'
                  sh 'docker rmi registry.home.glroland.com/distribution-center/supervisor-api:$BUILD_NUMBER'

                  sh 'docker load -i dashboard-ui/dashboard-ui-dockerimage.tar'
                  sh 'docker tag dashboard-ui:$BUILD_NUMBER registry.home.glroland.com/distribution-center/dashboard-ui:$BUILD_NUMBER'
                  sh 'docker rmi dashboard-ui:$BUILD_NUMBER'
                  sh 'docker push registry.home.glroland.com/distribution-center/dashboard-ui:$BUILD_NUMBER'
                  sh 'docker rmi registry.home.glroland.com/distribution-center/dashboard-ui:$BUILD_NUMBER'

                  sh 'docker load -i local-dc-agent/local-dc-agent-dockerimage.tar'
                  sh 'docker tag local-dc-agent:$BUILD_NUMBER registry.home.glroland.com/distribution-center/local-dc-agent:$BUILD_NUMBER'
                  sh 'docker rmi local-dc-agent:$BUILD_NUMBER'
                  sh 'docker push registry.home.glroland.com/distribution-center/local-dc-agent:$BUILD_NUMBER'
                  sh 'docker rmi registry.home.glroland.com/distribution-center/local-dc-agent:$BUILD_NUMBER'

                  sh 'docker load -i local-wms-api/local-wms-api-dockerimage.tar'
                  sh 'docker tag local-wms-api:$BUILD_NUMBER registry.home.glroland.com/distribution-center/local-wms-api:$BUILD_NUMBER'
                  sh 'docker rmi local-wms-api:$BUILD_NUMBER'
                  sh 'docker push registry.home.glroland.com/distribution-center/local-wms-api:$BUILD_NUMBER'
                  sh 'docker rmi registry.home.glroland.com/distribution-center/local-wms-api:$BUILD_NUMBER'

                  sh 'docker load -i local-inventory-robot-api/local-inventory-robot-api-dockerimage.tar'
                  sh 'docker tag local-inventory-robot-api:$BUILD_NUMBER registry.home.glroland.com/distribution-center/local-inventory-robot-api:$BUILD_NUMBER'
                  sh 'docker rmi local-inventory-robot-api:$BUILD_NUMBER'
                  sh 'docker push registry.home.glroland.com/distribution-center/local-inventory-robot-api:$BUILD_NUMBER'
                  sh 'docker rmi registry.home.glroland.com/distribution-center/local-inventory-robot-api:$BUILD_NUMBER'

                  sh 'docker load -i local-shipping-api/local-shipping-api-dockerimage.tar'
                  sh 'docker tag local-shipping-api:$BUILD_NUMBER registry.home.glroland.com/distribution-center/local-shipping-api:$BUILD_NUMBER'
                  sh 'docker rmi local-shipping-api:$BUILD_NUMBER'
                  sh 'docker push registry.home.glroland.com/distribution-center/local-shipping-api:$BUILD_NUMBER'
                  sh 'docker rmi registry.home.glroland.com/distribution-center/local-shipping-api:$BUILD_NUMBER'

                  sh 'docker load -i label-api/label-api-dockerimage.tar'
                  sh 'docker tag label-api:$BUILD_NUMBER registry.home.glroland.com/distribution-center/label-api:$BUILD_NUMBER'
                  sh 'docker rmi label-api:$BUILD_NUMBER'
                  sh 'docker push registry.home.glroland.com/distribution-center/label-api:$BUILD_NUMBER'
                  sh 'docker rmi registry.home.glroland.com/distribution-center/label-api:$BUILD_NUMBER'

                  sh 'docker load -i eval-suite/eval-suite-dockerimage.tar'
                  sh 'docker tag eval-suite:$BUILD_NUMBER registry.home.glroland.com/distribution-center/eval-suite:$BUILD_NUMBER'
                  sh 'docker rmi eval-suite:$BUILD_NUMBER'
                  sh 'docker push registry.home.glroland.com/distribution-center/eval-suite:$BUILD_NUMBER'
                  sh 'docker rmi registry.home.glroland.com/distribution-center/eval-suite:$BUILD_NUMBER'

                  sh 'docker load -i vision-ml/vision-ml-trainer-dockerimage.tar'
                  sh 'docker tag vision-ml-trainer:$BUILD_NUMBER registry.home.glroland.com/distribution-center/vision-ml-trainer:$BUILD_NUMBER'
                  sh 'docker rmi vision-ml-trainer:$BUILD_NUMBER'
                  sh 'docker push registry.home.glroland.com/distribution-center/vision-ml-trainer:$BUILD_NUMBER'

                  // Also tagged+pushed as :latest (unlike the services above, this
                  // image isn't deployed via deploy/helm's global.imageTag - it's
                  // referenced directly by vision-ml/src/pipeline.py's TRAINER_IMAGE
                  // default, baked into pipeline.yaml at compile time, so :latest
                  // needs to stay current for that default to keep working).
                  sh 'docker tag registry.home.glroland.com/distribution-center/vision-ml-trainer:$BUILD_NUMBER registry.home.glroland.com/distribution-center/vision-ml-trainer:latest'
                  sh 'docker push registry.home.glroland.com/distribution-center/vision-ml-trainer:latest'
                  sh 'docker rmi registry.home.glroland.com/distribution-center/vision-ml-trainer:$BUILD_NUMBER'
                  sh 'docker rmi registry.home.glroland.com/distribution-center/vision-ml-trainer:latest'
               }
            }
         }
      }
   }
}
