HOST=0.0.0.0

# Each local service needs its own port. These are what the Makefile's
# run-* targets use to override the generic PORT for their sub-process.
PO_INGEST_API_PORT=8000
AGENT_PORT=9100
WMS_API_PORT=8001
ROBOT_API_PORT=8002
SUPERVISOR_API_PORT=8003
SHIPPING_API_PORT=8004
LABEL_GENERATOR_API_PORT=8005
DASHBOARD_PORT=8090

LOCATION_NAME=DC-VIRTUAL-01

INVENTORY_CSV_PATH=data/inventory.csv
SHELVES_CSV_PATH=data/shelves.csv
PO_DIRS=target/pos,test-po-generator/output

PUBLIC_URL=http://localhost:${DASHBOARD_PORT}
PO_INGEST_API_URL=http://localhost:${PO_INGEST_API_PORT}
WMS_API_URL=http://localhost:${WMS_API_PORT}
ROBOT_API_URL=http://localhost:${ROBOT_API_PORT}
SUPERVISOR_API_URL=http://localhost:${SUPERVISOR_API_PORT}
SHIPPING_API_URL=http://localhost:${SHIPPING_API_PORT}
LABEL_GENERATOR_API_URL=http://localhost:${LABEL_GENERATOR_API_PORT}
AGENT_URL=

OPENAI_BASE_URL=http://localhost:9999/v1
OPENAI_MODEL=gemma-4
OPENAI_API_KEY=nokeyneeded

GRID_WIDTH=10
GRID_HEIGHT=10
DOCK_X=0
DOCK_Y=0
CARRY_CAPACITY=100
MAX_FULFILLMENT_TURNS=20
